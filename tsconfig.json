{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2017"
    ],
    "types": [
      "@figma/plugin-typings"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}